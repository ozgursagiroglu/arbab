{
  "name": "ui",
  "base": "ui-base",
  "defaults": { "role": "implementer", "effort": "high", "budgetUsd": 20, "wallMin": 90, "idleMin": 20 },
  "phases": [
    {
      "name": "ui-server",
      "brief": "lanes/ui-server.md",
      "scope": [
        "src/ui/server/**",
        "src/commands/ui.ts",
        "src/commands/ui.test.ts",
        "src/commands/index.ts",
        "src/commands/context.ts",
        "src/commands/testkit.ts",
        "src/stream/digest.ts",
        "src/stream/index.ts",
        "src/stream/digest.test.ts",
        "test/e2e/ui.test.ts"
      ]
    },
    {
      "name": "ui-scene",
      "brief": "lanes/ui-scene.md",
      "scope": ["src/ui/client/scene/**"]
    },
    {
      "name": "ui-art",
      "brief": "lanes/ui-art.md",
      "scope": ["src/ui/client/app/**", "scripts/build.mjs", "scripts/build.d.mts", "test/build.test.ts", "docs/ui/**"],
      "budgetUsd": 30,
      "wallMin": 120
    },
    {
      "name": "ui-wire",
      "brief": "lanes/ui-wire.md",
      "scope": ["src/ui/server/**", "src/ui/client/scene/**", "src/ui/client/app/**", "src/ui/client/pipeline.test.ts", "docs/ui/**", "test/e2e/ui.test.ts"],
      "dependsOn": ["ui-server", "ui-scene", "ui-art"]
    }
  ]
}
